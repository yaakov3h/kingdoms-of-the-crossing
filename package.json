{
  "name": "kingdoms-independent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx tests.ts",
    "test:solo": "tsx tests-solo.ts",
    "test:ui": "node qa-ui-2.mjs && node qa-ui-3.mjs && node qa-ui-4.mjs && node qa-ui-5.mjs && node qa-ui-6.mjs",
    "build:portable": "vite build --config vite.portable.config.ts && python3 scripts/build-portable.py"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "22.15.30",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "wrangler": "^4.167.0"
  }
}
